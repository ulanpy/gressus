POSTGRES_USER=gressus
POSTGRES_PASSWORD=examplepass
POSTGRES_DB=gressus_db
# Use gressus-postgres:5432 inside docker bridge network (pgadmin).
# Backend runs with host network — docker-compose overrides to 127.0.0.1:5435.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
PGADMIN_DEFAULT_EMAIL=name@example.com
PGADMIN_DEFAULT_PASSWORD=example_pgpass
