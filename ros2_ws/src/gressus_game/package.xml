<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gressus_game</name>
  <version>0.0.0</version>
  <description>Gressus treadmill tile game</description>
  <maintainer email="ulan.sharipov@nu.edu.kz">root</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>gressus_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>std_msgs</depend>
